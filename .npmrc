@mindulle:registry=https://npm.pkg.github.com
onlyBuiltDependencies=["esbuild", "sharp", "unrs-resolver"]

# 인증 토큰은 여기(커밋되는 프로젝트 .npmrc)에 두지 않습니다.
# pnpm v10.34.2 / v11.5.3 부터 보안 패치(GHSA-3qhv-2rgh-x77r)로 프로젝트 .npmrc의
# ${VAR} 자리표시자는 더 이상 치환되지 않습니다 (악성 저장소가 CI 시크릿을
# 임의 레지스트리로 유출하는 걸 막기 위함). CI에서는 `pnpm config set`으로
# 신뢰된 global 설정에 주입하고, 로컬 개발자는 각자 ~/.npmrc에
# `//npm.pkg.github.com/:_authToken=<PAT>` 한 줄을 추가하세요.
